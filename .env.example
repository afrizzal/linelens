# Copy to .env before `docker compose up`.
# Values below are the in-compose (service-name) hosts; see the localhost
# comments for running an app on the host against dockerized infra.

# --- Postgres ---
POSTGRES_USER=linelens
POSTGRES_PASSWORD=linelens-dev
POSTGRES_DB=linelens

# In-compose DATABASE_URL (used by simulator/worker/web services):
DATABASE_URL=postgresql://linelens:linelens-dev@db:5432/linelens
# Host-side dev (running an app with `pnpm dev` outside docker), use instead:
# DATABASE_URL=postgresql://linelens:linelens-dev@localhost:5432/linelens

# --- MQTT (Mosquitto) ---
# In-compose:
MQTT_URL=mqtt://mqtt:1883
# Host-side dev:
# MQTT_URL=mqtt://localhost:1883

# --- Simulator ---
# Real-time clock multiplier (speedFactor). 1 = real time; 60 = a sim day
# passes in 24 real minutes. Overrides the plant.config.json default at boot.
SIM_SPEED=60
# Deterministic seed for the synthetic plant's RNG. The authoritative default
# seed lives in plant.config.json; this env var only overrides it.
SIM_SEED=42
# How long the simulator waits for the ingestion worker to confirm its MQTT
# subscription before releasing the warm-start burst. The simulator publishes a
# full sim-day in ~1.5s at boot, and MQTT clean:false + QoS1 only replays into a
# session that ALREADY exists -- so without this wait a clean `docker compose
# up` loses the entire warm-start day. On timeout it warm-starts anyway and logs
# loudly, so running the simulator without a worker still works. Rarely needs
# changing; lower it only when deliberately running the simulator standalone.
# INGESTOR_READY_TIMEOUT_MS=120000

# --- Web -> Simulator control proxy (consumed starting Phase 3) ---
# In-compose:
SIMULATOR_URL=http://simulator:4000
# Host-side dev:
# SIMULATOR_URL=http://localhost:4000
